# Plantilla SIN secretos reales
# Configurar cuando se decida el stack.
LOYVERSE_ACCESS_TOKEN=
DATABASE_URL=

# ASP.NET Core lee variables del proceso; no carga .env automáticamente.
ASPNETCORE_URLS=http://localhost:5080
ConnectionStrings__LoyOrder=Host=localhost;Port=5432;Database=loyorder;Username=loyorder;Password=CAMBIAR;Timeout=3;Command Timeout=5

# 7.2.1: en desarrollo se genera una clave efímera si no se configura.
ASPNETCORE_ENVIRONMENT=Development
# Auth__SigningKey=BASE64_DE_32_BYTES_ALEATORIOS_COMO_MINIMO

# Pedidos: consultar docs/ACTIVIDAD_PEDIDOS_2026_11_25.md
Pedidos__ZonaHoraria=America/Mexico_City
# Requiere configuración completa de CorreoAutenticacion; false conserva la cola sin enviar.
Notificaciones__Habilitado=false
