<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>LoyOrder.Infrastructure.Loyverse</RootNamespace>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <!-- IHttpClientFactory, Options, Logging e inyección de dependencias vienen en el framework de ASP.NET Core:
       no hace falta ningún paquete de NuGet. -->
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="LoyOrder.Infrastructure.Loyverse.Tests" />
  </ItemGroup>

</Project>
