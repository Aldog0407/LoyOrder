<Project Sdk="Microsoft.NET.Sdk">

  <!-- 7.2.11 · Impresión ESC/POS por red (TCP 9100) para el ticket de venta y, en 7.2.20, las comandas por estación. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>LoyOrder.Infrastructure.Impresion</RootNamespace>
  </PropertyGroup>

  <!-- Options, Logging e inyección de dependencias vienen en el framework de ASP.NET Core; las páginas de códigos
       (CodePagesEncodingProvider) vienen en .NET. No hace falta ningún paquete de NuGet. -->
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../application/LoyOrder.Application/LoyOrder.Application.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="LoyOrder.Infrastructure.Impresion.Tests" />
  </ItemGroup>

</Project>
