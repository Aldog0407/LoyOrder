<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- 7.2.3: en Development el token de la cuenta de prueba de Loyverse se guarda con dotnet user-secrets -->
    <UserSecretsId>loyorder-api</UserSecretsId>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../../application/LoyOrder.Application/LoyOrder.Application.csproj" />
    <ProjectReference Include="../../infrastructure/LoyOrder.Infrastructure.Persistence/LoyOrder.Infrastructure.Persistence.csproj" />
    <ProjectReference Include="../../infrastructure/LoyOrder.Infrastructure.Loyverse/LoyOrder.Infrastructure.Loyverse.csproj" />
    <ProjectReference Include="../../infrastructure/LoyOrder.Infrastructure.Impresion/LoyOrder.Infrastructure.Impresion.csproj" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.0" />
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.15" />
    <PackageReference Include="Swashbuckle.AspNetCore.SwaggerUI" Version="11.0.1" />
    <PackageReference Include="MailKit" Version="4.18.2" />
  </ItemGroup>
</Project>
